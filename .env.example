MARIADB_ROOT_PASSWORD=change_me_root
RCT_DB_NAME=rct
RCT_DB_USER=rct
RCT_DB_PASSWORD=change_me_db
# >= 32 Bytes, z. B.: openssl rand -base64 48
JWT_KEY=change_me_to_a_random_string_of_at_least_32_bytes
# Admin-Konto (wird beim ersten Start angelegt; 'change_me' wird verweigert)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com
API_EXTERNAL_PORT=5080
FRONTEND_EXTERNAL_PORT=8090
# Passwort-Reset-Mails (optional; leer = Feature loggt nur)
APP_BASE_URL=https://rct.example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Real Chess Training
EMAIL_USE_STARTTLS=true
ASPNETCORE_ENVIRONMENT=Production
